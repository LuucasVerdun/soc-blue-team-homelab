
    <group>correlation,sysmon,powershell,lsass,credential_access_investigation,case14,soc_lab,</group>
  </rule>

  <!-- CASE 15 - standard user changes vulnerable service configuration -->
  <rule id="100325" level="8">
    <if_sid>92005</if_sid>

    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^sc\.exe\s+config\s+SOC_CASE15\s+binPath=.*case15-marker-[0-9]{8}-[0-9]{6}\.cmd</field>
    <field name="win.eventdata.user" type="pcre2">(?i)\\soccase15$</field>
    <field name="win.eventdata.integrityLevel">^Medium$</field>

    <description>SOC LAB: Standard user modified SOC_CASE15 service configuration to execute the controlled marker script.</description>

    <mitre>
      <id>T1543.003</id>
    </mitre>

    <group>sysmon,service_modification,privilege_escalation,case15,soc_lab,</group>
  </rule>

  <!-- CASE 15 - Service Control Manager writes the modified ImagePath -->
  <rule id="100330" level="10">
    <if_sid>92307</if_sid>

    <field name="win.eventdata.targetObject" type="pcre2">(?i)SOC_CASE15\\\\ImagePath$</field>
    <field name="win.eventdata.details" type="pcre2">(?i)case15-marker-[0-9]{8}-[0-9]{6}\.cmd$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\services\.exe$</field>

    <description>SOC LAB: SOC_CASE15 ImagePath was changed to the controlled Case15 marker command.</description>

    <mitre>
      <id>T1543.003</id>
    </mitre>

    <group>sysmon,registry,service_modification,case15,soc_lab,</group>
  </rule>


  <!-- CASE 15 - standard user starts vulnerable LocalSystem service -->
  <rule id="100335" level="10">
    <if_sid>92032</if_sid>

    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^sc\.exe\s+start\s+SOC_CASE15$</field>
    <field name="win.eventdata.user" type="pcre2">(?i)\\soccase15$</field>
    <field name="win.eventdata.integrityLevel">^Medium$</field>

    <description>SOC LAB: Standard user started the controlled SOC_CASE15 LocalSystem service.</description>

    <mitre>
      <id>T1569.002</id>
    </mitre>

    <group>sysmon,service_execution,privilege_escalation,case15,soc_lab,</group>
  </rule>


  <!-- CASE 15 - SYSTEM execution from controlled service payload -->
  <rule id="100340" level="12">
    <if_sid>92032</if_sid>

    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <field name="win.eventdata.user" type="pcre2">(?i)SYSTEM$</field>
    <field name="win.eventdata.integrityLevel">^System$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\cmd\.exe$</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)case15-marker-[0-9]{8}-[0-9]{6}\.cmd</field>

    <description>SOC LAB: Controlled Case15 service payload executed a child process as NT AUTHORITY SYSTEM.</description>

    <mitre>
      <id>T1569.002</id>
      <id>T1059.003</id>
    </mitre>

    <group>sysmon,system_execution,service_execution,privilege_escalation,case15,soc_lab,</group>
  </rule>


  <!-- CASE 15 - SYSTEM creates controlled privilege-escalation marker -->
  <rule id="100345" level="12">
    <if_sid>61613</if_sid>

    <field name="win.eventdata.image" type="pcre2">(?i)\\cmd\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)case15-system-marker-[0-9]{8}-[0-9]{6}\.txt$</field>
    <field name="win.eventdata.user" type="pcre2">(?i)SYSTEM$</field>

    <description>SOC LAB: NT AUTHORITY SYSTEM created the controlled Case15 privilege-escalation marker.</description>

    <mitre>
      <id>T1569.002</id>
    </mitre>

    <group>sysmon,file_creation,system_execution,privilege_escalation,case15,soc_lab,</group>
  </rule>

  <!-- CASE 15 - standard-user service modification confirmed in Registry -->
