    <group>rdp,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <rule id="100165" level="7" timeframe="10">
    <if_sid>100135</if_sid>
    <if_matched_sid>100160</if_matched_sid>

    <description>SOC LAB: Failed Windows authentication associated with a recent RDP connection.</description>

    <group>authentication_failed,rdp,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100170" level="12" frequency="4" timeframe="60">
    <if_matched_sid>100165</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>

    <description>SOC LAB: Repeated RDP authentication failures against the same Windows account from the same source IP.</description>

    <group>authentication_failed,rdp,brute_force,password_guessing,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100175" level="14" timeframe="300">
    <if_sid>92653</if_sid>
    <if_matched_sid>100170</if_matched_sid>

    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>

    <description>SOC LAB: Successful RDP logon after repeated password guessing from the same source IP.</description>

    <group>authentication_success,rdp,password_guessing,valid_accounts,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <rule id="100180" level="6">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000001$</field>

    <description>SOC LAB: Suricata detected an RDP connection attempt from WIN10 to WINSERVER2022.</description>

    <group>suricata,ids,rdp,network_detection,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <rule id="100185" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000002$</field>

    <description>SOC LAB: Suricata detected a possible TCP port scan against WINSERVER2022.</description>

    <group>suricata,ids,network_scan,reconnaissance,soc_lab,</group>

    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100190" level="5">
    <decoded_as>json</decoded_as>

    <field name="id.orig_h">^192\.168\.100\.20$</field>
    <field name="id.resp_h">^192\.168\.100\.30$</field>
    <field name="id.resp_p">^3389$</field>
    <field name="proto">^tcp$</field>

    <description>SOC LAB: Zeek observed an RDP connection from WIN10 to WINSERVER2022.</description>

    <group>zeek,network_connection,rdp,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <rule id="100195" level="7">
    <decoded_as>json</decoded_as>

    <field name="id.orig_h">^192\.168\.100\.20$</field>
    <field name="id.resp_h">^192\.168\.100\.30$</field>
    <field name="id.resp_p">^53$</field>
    <field name="query" type="pcre2">(?i)^(?:[a-z0-9-]+\.)*soc-lab-beacon\.example\.?$</field>

    <description>SOC LAB: Zeek detected a controlled suspicious DNS query from WIN10.</description>

    <group>zeek,dns,network_detection,soc_lab,</group>

    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="100200" level="10" frequency="4" timeframe="15">
    <if_matched_sid>100195</if_matched_sid>

    <same_field>id.orig_h</same_field>
    <same_field>query</same_field>

    <description>SOC LAB: Repeated suspicious DNS queries from the same source may indicate beacon-like activity.</description>

    <group>zeek,dns,beaconing,command_and_control,soc_lab,</group>

    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="100205" level="15" timeframe="600">
    <if_sid>100175</if_sid>
    <if_matched_sid>100185</if_matched_sid>

    <global_frequency />

    <field name="win.eventdata.ipAddress">^192\.168\.100\.20$</field>

    <description>SOC LAB: Network reconnaissance followed by successful RDP access after password guessing.</description>

    <group>correlation,multi_source,suricata,windows,rdp,reconnaissance,lateral_movement,soc_lab,</group>

    <mitre>
      <id>T1046</id>
      <id>T1021.001</id>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <rule id="100210" level="15" timeframe="300">
    <if_sid>100205</if_sid>
    <if_matched_sid>100190</if_matched_sid>

    <global_frequency />

    <field name="win.eventdata.ipAddress">^192\.168\.100\.20$</field>

    <description>SOC LAB: Tri-source correlation - Suricata reconnaissance, Zeek RDP network activity, and successful Windows RDP access after password guessing.</description>

    <group>correlation,multi_source,suricata,zeek,windows,rdp,reconnaissance,credential_access,lateral_movement,soc_lab,</group>

    <mitre>
      <id>T1046</id>
      <id>T1110.001</id>
      <id>T1021.001</id>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <rule id="100215" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000003$</field>

    <description>SOC LAB: Suricata detected a possible HTTP command injection attempt against WINSERVER2022.</description>

    <group>suricata,ids,http,web_attack,command_injection,soc_lab,</group>
  </rule>

  <rule id="100220" level="8">
    <if_sid>61650</if_sid>

    <field name="win.eventdata.queryName" type="pcre2">(?i)^(?:[a-z0-9-]+\.)*soc-lab-beacon\.example\.?$</field>

    <description>SOC LAB: Sysmon observed a controlled suspicious DNS query from $(win.eventdata.image).</description>

    <group>sysmon,dns,endpoint_detection,soc_lab,</group>
  </rule>

  <rule id="100225" level="13" timeframe="60">
    <if_sid>100200</if_sid>
    <if_matched_sid>100220</if_matched_sid>

    <global_frequency />

    <field name="query" type="pcre2">(?i)^(?:[a-z0-9-]+\.)*soc-lab-beacon\.example\.?$</field>

    <description>SOC LAB: Multi-source correlation - repeated DNS activity observed by Zeek and attributed to an endpoint process by Sysmon.</description>

    <group>correlation,multi_source,zeek,sysmon,dns,endpoint_attribution,beaconing,soc_lab,</group>
  </rule>

  <rule id="100230" level="13" timeframe="120">
    <if_sid>67014</if_sid>
    <if_matched_sid>100130</if_matched_sid>

    <field name="win.eventdata.taskName" type="pcre2">(?i)SOC-LAB-CASE07$</field>

    <description>SOC LAB: Discovery activity was followed by registration of the controlled scheduled task $(win.eventdata.taskName).</description>

    <mitre>
      <id>T1053.005</id>
    </mitre>

    <group>correlation,task_scheduler,persistence,discovery,soc_lab,</group>
  </rule>

  <rule id="100235" level="15" timeframe="90">
    <if_sid>92052</if_sid>
    <if_matched_sid>100230</if_matched_sid>

    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)svchost\.exe.*-s\s+Schedule\b</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)SOC\s+CASE\s+07\s+CONTROLLED\s+TASK</field>

    <description>SOC LAB: Correlated endpoint chain - discovery followed by scheduled task registration and task-driven command execution.</description>

    <mitre>
      <id>T1053.005</id>
      <id>T1059.003</id>
    </mitre>

    <group>correlation,endpoint,sysmon,task_scheduler,persistence,execution,discovery,soc_lab,</group>
  </rule>

</group>
