<group name="local,syslog,sshd,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100100" level="10">
    <if_sid>91802</if_sid>
    <field name="win.system.eventID">4104</field>
    <field name="win.eventdata.scriptBlockText">SOC-LAB-DETECTION-TEST</field>
    <description>SOC LAB: PowerShell Script Block test detected.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,soc_lab,</group>
  </rule>

  <rule id="100110" level="8">
    <if_sid>92004</if_sid>
    <field name="win.eventdata.integrityLevel" type="pcre2">(?i)^High$</field>
    <description>SOC LAB: PowerShell spawned CMD with High integrity.</description>
    <mitre>
      <id>T1059.003</id>
    </mitre>
    <group>sysmon,powershell,windows_command_shell,soc_lab,</group> 
  </rule>

  <rule id="100120" level="10">
    <if_sid>100110</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bwhoami\b</field>
    <description>SOC LAB: High-integrity PowerShell spawned CMD and executed whoami.</description>
    <mitre>
      <id>T1033</id>
      <id>T1059.003</id>
    </mitre>
    <group>sysmon,powershell,discovery,windows_command_shell,soc_lab,</group>
  </rule>

  <rule id="100130" level="12">
    <if_sid>100110</if_sid>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bwhoami\b</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bhostname\b</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bipconfig\b</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bnet\s+user\b</field>

    <description>SOC LAB: Multiple Windows discovery commands executed from elevated PowerShell.</description>

    <mitre>
      <id>T1033</id>
      <id>T1016</id>
      <id>T1087.001</id>
      <id>T1059.003</id>
    </mitre>

    <group>sysmon,powershell,discovery,multiple_discovery_commands,soc_lab,</group>
  </rule>

</group>

<group name="local,windows,authentication,brute_force,soc_lab,">

  <rule id="100135" level="6">
    <if_sid>60122</if_sid>
    <field name="win.eventdata.subStatus" type="pcre2">(?i)^0xc000006a$</field>
    <description>SOC LAB: Windows logon failure caused by incorrect password for an existing account.</description>
    <group>authentication_failed,password_failure,soc_lab,</group>
  </rule>

  <rule id="100140" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100135</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>SOC LAB: Repeated password failures against the same Windows account from the same source IP.</description>
    <group>authentication_failed,brute_force,password_guessing,soc_lab,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100145" level="4">
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <description>SOC LAB: Successful Windows network logon.</description>
    <group>authentication_success,network_logon,soc_lab,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>


  <rule id="100150" level="14" timeframe="300">
    <if_sid>100145</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>SOC LAB: Successful Windows network logon after repeated password guessing attempts.</description>
    <group>authentication_success,possible_account_compromise,password_guessing,soc_lab,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>
  <rule id="100155" level="13" timeframe="300">
    <if_sid>60115</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>

    <description>SOC LAB: Windows account locked out after repeated password guessing attempts.</description>

    <group>authentication_failed,account_lockout,password_guessing,soc_lab,</group>

    <mitre>
      <id>T1110.001</id>
      <id>T1531</id>
    </mitre>
  </rule>

  <rule id="100160" level="5">
    <if_sid>60009</if_sid>

    <field name="win.system.providerName" type="pcre2">^Microsoft-Windows-TerminalServices-RemoteConnectionManager$</field>
    <field name="win.system.eventID">^261$</field>

    <description>SOC LAB: RDP connection received by Windows Remote Desktop listener.</description>

    <group>rdp,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <rule id="100165" level="7" timeframe="10">
    <if_sid>100135</if_sid>
    <if_matched_sid>100160</if_matched_sid>

    <description>SOC LAB: Failed Windows authentication associated with a recent RDP connection.</description>

    <group>authentication_failed,rdp,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100170" level="12" frequency="4" timeframe="60">
    <if_matched_sid>100165</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>

    <description>SOC LAB: Repeated RDP authentication failures against the same Windows account from the same source IP.</description>

    <group>authentication_failed,rdp,brute_force,password_guessing,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100175" level="14" timeframe="300">
    <if_sid>92653</if_sid>
    <if_matched_sid>100170</if_matched_sid>

    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>

    <description>SOC LAB: Successful RDP logon after repeated password guessing from the same source IP.</description>

    <group>authentication_success,rdp,password_guessing,valid_accounts,remote_access,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <rule id="100180" level="6">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000001$</field>

    <description>SOC LAB: Suricata detected an RDP connection attempt from WIN10 to WINSERVER2022.</description>

    <group>suricata,ids,rdp,network_detection,soc_lab,</group>

    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <rule id="100185" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000002$</field>

    <description>SOC LAB: Suricata detected a possible TCP port scan against WINSERVER2022.</description>

    <group>suricata,ids,network_scan,reconnaissance,soc_lab,</group>

    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

</group>
